APP_NAME=FinanceIQ
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

POSTGRES_USER=financeiq
POSTGRES_PASSWORD=financeiq
POSTGRES_DB=financeiq

# Restricted, non-superuser role — the app connects as this, so Postgres row-level security
# actually applies to it (POSTGRES_USER above is a superuser and always bypasses RLS).
POSTGRES_APP_USER=financeiq_app
POSTGRES_APP_PASSWORD=financeiq_app

# The app's own runtime connection, via the restricted role.
DATABASE_URL=postgresql+psycopg://financeiq_app:financeiq_app@db:5432/financeiq
# Alembic-only: needs DDL privileges (CREATE TABLE, CREATE POLICY, ...) the app role doesn't have.
MIGRATION_DATABASE_URL=postgresql+psycopg://financeiq:financeiq@db:5432/financeiq

JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
